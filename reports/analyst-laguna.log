import sys,json
text = sys.stdin.read()
# find all sidebar-related JSON schemas
for ns in ['sidebarsPrivate', 'sidebarAction']:
    idx = text.find(f'\"namespace\":\"{ns}\"')
    if idx < 0:
        print(f'{ns}: NOT FOUND')
        continue
    # find the enclosing JSON object
    start = text.rfind('{', 0, idx)
    depth=0
    end=0
    for i in range(start, len(text)):
        if text[i]=='{': depth+=1
        elif text[i]=='}':
            depth-=1
            if depth==0:
                end=i+1
                break
    try:
        obj = json.loads(text[start:end])
        # print functions
        funcs = [f['name'] for f in obj.get('functions',[])]
        print(f'{ns} functions: {funcs}')
        # print types
        for t in obj.get('types',[]):
            print(f'  type: {t[\"id\"]}')
        # print events
        for e in obj.get('events',[]):
            print(f'  event: {e[\"name\"]}')
    except Exception as e:
        print(f'{ns}: parse error - {e}')
"
