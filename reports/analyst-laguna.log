    if end > 0:
        end += 7
        snippet = data[start:end]
        if len(snippet) < 5000:
            print(f'--- HTML block at {start:#x} ({len(snippet)} bytes) ---')
            print(snippet.decode('utf-8', errors='replace')[:2000])
            print()
