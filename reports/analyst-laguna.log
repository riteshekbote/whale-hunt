data = open('WhaleSetup.exe', 'rb').read()
# Search for 'Cdn' context and nearby strings
import re
for m in re.finditer(b'Cdn', data):
    s = max(0, m.start()-100)
    e = min(len(data), m.end()+200)
    snippet = data[s:e]
    # Show printable chars
    text = ''
    for b in snippet:
        if 32 <= b < 127 or b in (10, 13, 9):
            text += chr(b)
        else:
            text += '.'
    print(text)
    print('---')
" 2>/dev/null | head -60
