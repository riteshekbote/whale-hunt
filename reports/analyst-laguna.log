whale.runtime.onMessage.addListener((message, sender, sendResponse) => {
  if (message === 'sidebarAction.show') {
    whale.sidebarAction.show({
      reload : false
    }, () => {

    });
  } else if (message === 'sidebarAction.hide') {
    whale.sidebarAction.hide(() => {
    });
  } else if (message === 'sidebarAction.show2') {
    whale.windows.create((windowInfo) => {
      whale.sidebarAction.show(windowInfo.id, () => {

      });
    });
  } else if (message === 'sidebarAction.hideAll') {
    whale.windows.getAll((windowList) => {
      for(let i = 0, len = windowList.length ; i < len ; i++) {
        whale.sidebarAction.hide(windowList[i].id, () => {
        });
      }
    });
  }
});
