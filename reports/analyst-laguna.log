# Search for the Inno Setup signature
if b'Inno Setup' in data:
    print('Inno Setup installer detected')
else:
    print('NOT Inno Setup')
# Search for NSIS
if b'Makensis' in data or b'NSIS' in data:
    print('NSIS installer detected')
else:
    print('NOT NSIS')
# Try to find what kind of installer this is
# Check PE characteristics
import struct
# Parse PE header
if data[:2] == b'MZ':
    pe_offset = struct.unpack_from('<I', data, 0x3C)[0]
    if pe_offset < len(data) and data[pe_offset:pe_offset+4] == b'PE\x00\x00':
        print(f'Valid PE file at offset {pe_offset:#x}')
        # Check optional header
        opt_hdr_offset = pe_offset + 24
        magic = struct.unpack_from('<H', data, opt_hdr_offset)[0]
        if magic == 0x10b:
            print('PE32 (32-bit)')
        elif magic == 0x20b:
            print('PE32+ (64-bit)')
        # Check sections
        sect_offset = opt_hdr_offset + 224 if magic == 0x20b else opt_hdr_offset + 144
        num_sections = struct.unpack_from('<H', data, pe_offset + 6)[0]
        print(f'Number of sections: {num_sections}')
        for i in range(num_sections):
            s = sect_offset + i * 40
            name = data[s:s+8].rstrip(b'\x00').decode('ascii', errors='replace')
            vsize = struct.unpack_from('<I', data, s+8)[0]
            vaddr = struct.unpack_from('<I', data, s+12)[0]
            raw_size = struct.unpack_from('<I', data, s+16)[0]
            raw_offset = struct.unpack_from('<I', data, s+20)[0]
            print(f'  [{i}] {name:8s} vsize={vsize:#x} vaddr={vaddr:#x} raw_size={raw_size:#x} raw_offset={raw_offset:#x}')
