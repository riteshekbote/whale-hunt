import struct

with open('whalesetup.exe', 'rb') as f:
    data = f.read()

# PE header
pe_offset = struct.unpack_from('<I', data, 0x3C)[0]
print(f'PE header offset: 0x{pe_offset:04x}')

# COFF header
num_sections = struct.unpack_from('<H', data, pe_offset + 6)[0]
print(f'Number of sections: {num_sections}')

# Optional header
optional_header_offset = pe_offset + 24
magic = struct.unpack_from('<H', data, optional_header_offset)[0]
print(f'Optional header magic: 0x{magic:04x} (PE32=0x10b, PE32+={0x20b})')

# Section headers start after COFF header (20 bytes) + optional header
section_header_offset = pe_offset + 24 + (224 if magic == 0x20b else 208)
print(f'Section headers at: 0x{section_header_offset:06x}')

