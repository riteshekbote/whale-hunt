# .rsrc section: RawPtr=0x14800, VAddr=0x18000
rsrc_raw = 0x14800
rsrc_vaddr = 0x18000

def rva_to_raw(rva):
    return rsrc_raw + rva - rsrc_vaddr

# Parse resource directory at the beginning of .rsrc
def parse_res_dir(offset, level=0):
    magic = struct.unpack_from('<I', data, offset)[0]
    if magic != 0x00000000:
        print(f'  Bad magic at 0x{offset:06x}')
        return
    num_named = struct.unpack_from('<H', data, offset + 12)[0]
    num_id = struct.unpack_from('<H', data, offset + 14)[0]
    num_entries = num_named + num_id
    
    indent = '  ' * level
    for i in range(num_entries):
        entry_off = offset + 16 + i * 8
        entry_name = struct.unpack_from('<I', data, entry_off)[0]
        entry_data = struct.unpack_from('<I', data, entry_off + 4)[0]
        
        is_dir = entry_data & 0x80000000
        
        if is_dir:
            child_off = rva_to_raw(entry_data & 0x7FFFFFFF)
            print(f'{indent}DIR entry name=0x{entry_name:08x} -> offset 0x{child_off:08x}')
            parse_res_dir(child_off, level + 1)
        else:
            # Data entry
            data_entry_off = rva_to_raw(entry_data & 0x7FFFFFFF)
            # Data entry: RVA(4), Size(4), CodePage(4), Reserved(4)
            res_rva = struct.unpack_from('<I', data, data_entry_off)[0]
            res_size = struct.unpack_from('<I', data, data_entry_off + 4)[0]
            res_codepage = struct.unpack_from('<I', data, data_entry_off + 8)[0]
            res_file_off = rva_to_raw(res_rva)
            
            # Determine resource type name
            type_name = ''
            if entry_name & 0x80000000:
                type_name = 'STRING'
            else:
                # Standard resource types
                type_map = {1:'CURSOR',2:'BITMAP',3:'ICON',4:'DIALOG',5:'MENU',6:'STRING',7:'FONTDIR',8:'FONT',9:'ACCELERATOR',10:'RCDATA',11:'MESSAGETABLE',12:'COMPONENT',13:'GROUP_CURSOR',14:'GROUP_ICON',15:'VERSION',16:'DLGINDIRECT',17:'DUMMY',18:'DUMMY',19:'MENU_FB07',20:'EXTENDED_DOS',21:'FONTDIR',22:'FONT',23:'ACCELERATOR',24:'MANIFEST'}
                type_name = type_map.get(entry_name & 0xFFFF, f'TYPE_{entry_name & 0xFFFF}')
            
            # Check if it's an EXE (RT_RCDATA = 10)
            print(f'{indent}DATA name=0x{entry_name:08x} ({type_name}) size={res_size} file_off=0x{res_file_off:08x}')
            
            if res_size > 100000 and res_size < 12000000:
                # This could be the embedded EXE
                content = data[res_file_off:res_file_off+res_size]
                print(f'{indent}  First 16 bytes: {content[:16].hex()}')
                if content[:2] == b'MZ':
                    print(f'{indent}  *** FOUND EMBEDDED EXE! ***')
                    # Extract it
                    with open('/tmp/opencode/embedded_exe.bin', 'wb') as f:
                        f.write(content)
                    print(f'{indent}  Saved to embedded_exe.bin ({res_size} bytes)')

def parse_lang_dir(offset, level=0):
    # Language directory
    num_named = struct.unpack_from('<H', data, offset + 12)[0]
    num_id = struct.unpack_from('<H', data, offset + 14)[0]
    num_entries = num_named + num_id
    indent = '  ' * level
    for i in range(num_entries):
        entry_off = offset + 16 + i * 8
        entry_name = struct.unpack_from('<I', data, entry_off)[0]
        entry_data = struct.unpack_from('<I', data, entry_off + 4)[0]
        is_dir = entry_data & 0x80000000
        
        if is_dir:
            child_off = rva_to_raw(entry_data & 0x7FFFFFFF)
            print(f'{indent}LANG DIR name=0x{entry_name:08x} -> offset 0x{child_off:08x}')
        else:
            data_entry_off = rva_to_raw(entry_data & 0x7FFFFFFF)
            res_rva = struct.unpack_from('<I', data, data_entry_off)[0]
            res_size = struct.unpack_from('<I', data, data_entry_off + 4)[0]
            res_file_off = rva_to_raw(res_rva)
            print(f'{indent}LANG DATA name=0x{entry_name:08x} size={res_size} file_off=0x{res_file_off:08x}')
            if res_size > 100000:
                content = data[res_file_off:res_file_off+res_size]
                if content[:2] == b'MZ':
                    print(f'{indent}  *** FOUND EMBEDDED EXE! ***')
                    with open('/tmp/opencode/embedded_exe.bin', 'wb') as f:
                        f.write(content)
                    print(f'{indent}  Saved to embedded_exe.bin ({res_size} bytes)')

# Parse top-level directory
parse_res_dir(rsrc_raw)
