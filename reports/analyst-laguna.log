# Parse PE resource directory to find embedded resources
import struct

with open('whalesetup.exe', 'rb') as f:
    data = f.read()

# .rsrc section: RawPtr=0x14800
rsrc_raw = 0x14800
rsrc_vaddr = 0x18000

# Parse resource directory
# The resource directory starts at the beginning of .rsrc section in raw file
def parse_resource_directory(offset, depth=0):
    if depth > 3:
        return
    num_entries = struct.unpack_from('<H', data, offset + 12)[0]
    num_named = struct.unpack_from('<H', data, offset + 12 + 2)[0]
    
    for i in range(num_entries):
        entry_off = offset + 16 + i * 8
        name_rva = struct.unpack_from('<I', data, entry_off)[0]
        data_rva = struct.unpack_from('<I', data, entry_off + 4)[0]
        
        is_dir = data_rva & 0x80000000
        
        if is_dir:
            child_off = rsrc_raw + (data_rva & 0x7FFFFFFF) - rsrc_vaddr
            parse_resource_directory(child_off, depth + 1)
        else:
            # Data entry
            data_off = rsrc_raw + data_rva - rsrc_vaddr
            # Read the data entry: RVA(4), Size(4), CodePage(4), Reserved(4)
            data_rva_val, data_size, codepage, reserved = struct.unpack_from('<IIII', data, data_off)
            data_file_off = rsrc_raw + data_rva_val - rsrc_vaddr
            
            # Get the resource name from the parent directory entry
            if name_rva & 0x80000000:
                # String name (not ID)
                str_off = rsrc_raw + (name_rva & 0x7FFFFFFF) - rsrc_vaddr
                name_len = struct.unpack_from('<H', data, str_off)[0]
                name = data[str_off+2:str_off+2+name_len*2].decode('utf-16le', errors='replace')
            else:
                name = f'ID_{name_rva & 0xFFFF}'
            
            # Read string data
            content = data[data_file_off:data_file_off+data_size]
            if data_size <= 200:
                try:
                    readable = content.decode('utf-8', errors='replace')
                    if any(c.isprintable() for c in readable[:50]):
                        print(f'Resource: {name}, size={data_size}, offset=0x{data_file_off:08x}')
                        print(f'  Content: {readable[:200]}')
                        print()
                except:
                    pass

parse_resource_directory(rsrc_raw)
