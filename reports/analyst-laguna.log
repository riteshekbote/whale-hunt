import struct

with open('whalesetup.exe', 'rb') as f:
    data = f.read()

# PE header
pe_offset = struct.unpack_from('<I', data, 0x3C)[0]
print(f'PE header offset: 0x{pe_offset:06x}')

# COFF header fields
machine = struct.unpack_from('<H', data, pe_offset)[0]
num_sections = struct.unpack_from('<H', data, pe_offset + 6)[0]
print(f'Machine: 0x{machine:04x}, Sections: {num_sections}')

# Optional header
opt_off = pe_offset + 24
magic = struct.unpack_from('<H', data, opt_off)[0]
opt_size = 224 if magic == 0x20b else 208  # PE32+ vs PE32
print(f'Optional header magic: 0x{magic:04x}, size: {opt_size}')

# Section headers
section_off = opt_off + opt_size
print(f'Section headers at: 0x{section_off:06x}')

for i in range(num_sections):
    off = section_off + (i * 40)
    name_raw = data[off:off+8]
    name = name_raw.rstrip(b'\x00').decode('ascii', errors='replace')
    vsize = struct.unpack_from('<I', data, off+8)[0]
    vaddr = struct.unpack_from('<I', data, off+12)[0]
    raw_size = struct.unpack_from('<I', data, off+16)[0]
    raw_ptr = struct.unpack_from('<I', data, off+20)[0]
