data = open('WhaleSetup.exe', 'rb').read()
# Search for URL-like patterns including partial
import re
# Look for any URL fragments
for m in re.finditer(b'https?://[a-zA-Z0-9]', data):
    s = max(0, m.start()-20)
    e = min(len(data), m.end()+200)
    text = data[s:e]
    printable = ''.join(chr(b) if 32 <= b < 127 else '.' for b in text)
    if printable.strip('.: '):
        print(f'offset {m.start():#x}: {printable}')
" 2>/dev/null | head -40
