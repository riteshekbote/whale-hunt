import sys,json
text = sys.stdin.read()
for ns in ['sidebarsPrivate', 'sidebarAction']:
    idx = text.find(f'\"namespace\":\"{ns}\"')
    if idx < 0:
        print(f'{ns}: NOT FOUND')
        continue
    start = text.rfind('{', 0, idx)
    depth=0
    end=0
    for i in range(start, len(text)):
        if text[i]=='{': depth+=1
        elif text[i]=='}':
            depth-=1
            if depth==0:
                end=i+1
                break
    try:
        obj = json.loads(text[start:end])
        print(f'=== {ns} ===')
        print(json.dumps(obj,indent=2)[:6000])
    except Exception as e:
        print(f'{ns}: parse error - {e}')
    print()
