# Try to find the download URL by looking for it in different encodings
import base64

# Search for potential base64-encoded strings containing 'whale' or 'naver'
# Look for base64 strings of length >= 20
import re
b64_matches = re.findall(rb'[A-Za-z0-9+/]{20,}={0,2}', data)
for match in b64_matches:
    try:
        decoded = base64.b64decode(match)
        # Check if decoded contains any relevant keywords
        if any(kw in decoded.lower() for kw in [b'whale', b'naver', b'download', b'install', b'sync', b'passphrase']):
            # Find a URL pattern in decoded
            url_match = re.search(rb'https?://[^\x00\s]+', decoded)
            if url_match:
                print(f'B64 decoded URL: {url_match.group().decode()}')
            else:
                # Check for readable substring
                readable = re.findall(rb'[a-zA-Z0-9./_-]{10,}', decoded)
                for r in readable:
                    if any(kw in r.lower() for kw in [b'whale', b'naver', b'download', b'install']):
                        print(f'B64 match: {r.decode()}')
    except:
        pass
print('Done searching base64')
