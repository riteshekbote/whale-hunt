import struct
data = open('WhaleSetup.exe', 'rb').read()
# Parse PE import table
pe_offset = struct.unpack_from('<I', data, 0x3C)[0]
opt_hdr_offset = pe_offset + 24
num_dirs = struct.unpack_from('<I', data, opt_hdr_offset + 108)[0]
# Import table is directory 1
import_rva = struct.unpack_from('<I', data, opt_hdr_offset + 104)[0]  # DataDirectory[1].VirtualAddress
import_size = struct.unpack_from('<I', data, opt_hdr_offset + 108)[0]  # DataDirectory[1].Size
print(f'Import table RVA: {import_rva:#x}, Size: {import_size:#x}')

# Map RVA to file offset
# Parse section table
num_sections = struct.unpack_from('<H', data, pe_offset + 6)[0]
sect_offset = opt_hdr_offset + 224 if struct.unpack_from('<H', data, opt_hdr_offset)[0] == 0x20b else opt_hdr_offset + 144
sections = {}
for i in range(num_sections):
    s = sect_offset + i * 40
    name = data[s:s+8].rstrip(b'\x00').decode('ascii', errors='replace')
    vsize = struct.unpack_from('<I', data, s+8)[0]
    vaddr = struct.unpack_from('<I', data, s+12)[0]
    raw_size = struct.unpack_from('<I', data, s+16)[0]
    raw_offset = struct.unpack_from('<I', data, s+20)[0]
    sections[name] = (vaddr, vsize, raw_offset, raw_size)
    
# Convert import RVA to file offset
for name, (vaddr, vsize, raw_offset, raw_size) in sections.items():
    if import_rva >= vaddr and import_rva < vaddr + vsize:
        file_offset = raw_offset + (import_rva - vaddr)
        print(f'Import table in section \"{name}\" at file offset {file_offset:#x}')
        # Parse import descriptors
        import_data = data[file_offset:file_offset+import_size]
        # Each import descriptor is 20 bytes
        for j in range(0, len(import_data)-20, 20):
            name_rva = struct.unpack_from('<I', import_data, j+12)[0]
            if name_rva == 0:
                break
            # Convert name RVA to file offset
            if name_rva == 0:
                continue
            for sec_name, (svaddr, svsize, sroff, srsz) in sections.items():
                if name_rva >= svaddr and name_rva < svaddr + svsize:
                    name_offset = sroff + (name_rva - svaddr)
                    dll_name = data[name_offset:name_offset+100].split(b'\x00')[0].decode('ascii', errors='replace')
                    print(f'  Imports from: {dll_name}')
                    break
        break
