import struct, re

path = "/tmp/opencode/whale_x/extract/opt/naver/whale/resources.pak"
data = open(path, 'rb').read()

HDR = 18
first = struct.unpack_from('<I', data, HDR+2)[0]
table_end = HDR + first
print("first offset:", first, "table region:", HDR, "->", table_end)

entries = []
pos = HDR
while pos + 6 <= table_end:
    key, off = struct.unpack_from('<HI', data, pos)
    entries.append((key, off))
    pos += 6
print(f"parsed {len(entries)} entries; key range {min(k for k,_ in entries):#x}..{max(k for k,_ in entries):#x}")

# dedupe / last-wins for keys
res = {}
for key, off in entries:
    if off: res[key] = off

# blob boundaries: sorted by absolute offset
blobs = sorted([(k, HDR+o) for k, o in res.items()], key=lambda x: x[1])
out = {}
for idx, (k, s) in enumerate(blobs):
    e = blobs[idx+1][1] if idx+1 < len(blobs) else len(data)
    out[k] = data[s:e]

print(f"blobs: {len(out)} total bytes: {sum(len(b) for b in out.values())}")
