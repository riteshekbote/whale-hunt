print("first offset:", first, "-> est entries:", first//6)
entries = []
pos = HDR
while True:
    if pos+6 > len(data): break
    key, off = struct.unpack_from('<HI', data, pos)
    if off > len(data): break
    entries.append((key, off))
    pos += 6
    if off >= first: break  # reached end of resource table region
