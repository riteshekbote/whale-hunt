import struct, brotli, os

def parse_pak(path):
    with open(path,'rb') as fh:
        data = fh.read()
    version = struct.unpack_from('<I', data, 0)[0]
    enc = data[4]
    res_count = struct.unpack_from('<H', data, 8)[0]
    alias_count = struct.unpack_from('<H', data, 10)[0]
    header_len = 12
    index_size = (res_count+1)*6
    alias_size = alias_count*4
    entries = []
    for i in range(res_count+1):
        rid, off = struct.unpack_from('<HI', data, header_len + i*6)
        entries.append((rid, off))
    data_start = header_len + index_size + alias_size
    # compute each resource bytes
    out = []
    for i in range(res_count):
        rid, off = entries[i]
        nxt = entries[i+1][1]
        if off > nxt or nxt > len(data):
            continue
        out.append((rid, data[off:nxt]))
    return out, enc

for pak in ["extract/opt/naver/whale/resources.pak"]:
    res, enc = parse_pak(pak)
    print(f"{pak}: {len(res)} resources")
    hits = 0
    for rid, blob in res:
        text = None
        raw = blob
        try:
            text = brotli.decompress(blob).decode('utf-8', 'replace')
        except Exception:
            text = blob.decode('utf-8','replace')
        low = text.lower()
        if any(k in low for k in ["socket.io","socket_io","engine.io","whale_sync_push","service_worker","whalesync","/whalesync"]):
            hits += 1
            print(f"  HIT rid={rid} len={len(blob)} dl={len(text)} keys={[k for k in ['socket.io','socket_io','engine.io','whale_sync_push','service_worker','whalesync'] if k in low]}")
            os.makedirs("pak_out", exist_ok=True)
            with open(f"pak_out/{rid}.dat","wb") as f:
                f.write(text.encode('utf-8'))
    print(f"  total hits: {hits}")
EOF
