import struct
b = open('whale','rb').read()
TEXT_OFF=0x2e0e000; TEXT_VMA=0x2e0f000; TEXT_SIZE=0xf615316
targets = {
 'sync.encryption_bootstrap_token': 0x28B7A50,
 'sync.encryption_bootstrap_token_per_account': 0x28B7AA0,
 'sync.whale_need_encryption_key_forced_time': 0x28B7CF0,
 'nigori-key': 0x28B7E48,
 'sync.encryption_bootstrap_token_per_account_migration_done': 0x28B7AF0,
}
name_by_vma = {v:k for k,v in targets.items()}
text = b[TEXT_OFF:TEXT_OFF+TEXT_SIZE]
hits = {}
import re
for vma, name in targets.items():
    # scan for little-endian int32 displacement that resolves to vma at position p: ref = p+4+disp
    disp = (vma & 0xffffffff)
    hits.setdefault(vma, [])
count=0
# Build a set of target VMAs; scan every window
for p in range(0, len(text)-4, 1):
    d = struct.unpack_from('<i', text, p)[0]
    ref = TEXT_OFF + p + 4 + d   # file offset of referenced string... 
    # ref computed above is in file-offset space: p is file offset within text; insn starts at p-3 in file; lea len 7 => insn_end=p+4; target = insn_end + d
    ref_vma = ref  # for this binary, vma == file offset in .rodata
    if ref_vma in name_by_vma:
        insn_start = p - 3
        # only keep if instruction looks like 48 8D xx disp32 (LEA r64,[rip+d])
        if insn_start >= 0 and text[insn_start] == 0x48 and text[insn_start+1] == 0x8d:
            count += 1
            if count <= 12:
                print(f'xref {name_by_vma[ref_vma]} @ .text vma 0x{TEXT_VMA + (insn_start - 0):x} (file 0x{TEXT_OFF+insn_start:x}) bytes={text[insn_start:insn_start+7].hex()}')
print('total candidate LEA xrefs found:', count)
