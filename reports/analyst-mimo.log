        if data[i] == 0x55 and data[i+1:i+4] == b'\x48\x89\xe5':
            candidates.append(('push_rbp_mov_rbp', i))
        # Also check for any ret (0xc3) which would end the previous function
        elif data[i] == 0xc3:
