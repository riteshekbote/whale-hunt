import struct

BIN = "/tmp/opencode/whale_binary/extracted/opt/naver/whale/whale"
TEXT_VADDR = 0x30df000
TEXT_FOFF  = 0x30de000
TEXT_SIZE  = 0x0fa8dce8

with open(BIN, 'rb') as f:
    f.seek(TEXT_FOFF)
    text = f.read(TEXT_SIZE)

# For each call site, find the function prologue by scanning backwards for:
# push rbp (55) + mov rsp,rbp (48 89 e5) or similar
# Also look for UD2/INT3/RET as function boundaries

for target_name, call_vaddr in [("target1", 0x03c6d442), ("target2", 0x03c7d3d2)]:
    call_off = call_vaddr - TEXT_VADDR
    print(f"\n{'='*60}")
    print(f"{target_name}: call at {call_vaddr:#010x}")
    
    # Scan backwards for function prologue
    func_start = None
    for j in range(call_off, max(0, call_off-0x2000), -1):
        # Look for push rbp (55) or push rbx+push rbp pattern
        if text[j] == 0x55:
            # Check if it's a function prologue (push rbp)
            # Followed by mov rsp,rbp (48 89 e5) or sub rsp,imm
            if j+1 < len(text) and text[j+1] == 0x48:
                if j+2 < len(text) and text[j+2] == 0x89:
                    if j+3 < len(text) and text[j+3] == 0xe5:
                        func_start = TEXT_VADDR + j
                        break
            # Or just push rbp followed by other prologue instructions
            if j+1 < len(text) and text[j+1] in (0x48, 0x41, 0x48):
                func_start = TEXT_VADDR + j
                break
        # Also look for: xor ebp, ebp (31 ed) - common function start
        if text[j] == 0x31 and j+1 < len(text) and text[j+1] == 0xed:
            func_start = TEXT_VADDR + j
            break
    
    if func_start:
        print(f"  Function prologue found at {func_start:#010x}")
        # Show first few bytes of function
        func_off = func_start - TEXT_VADDR
        for k in range(min(20, call_off - func_off)):
            print(f"    {func_start+k:#010x}: {text[func_off+k]:02x}", end="")
            # Also decode
            b = text[func_off+k]
            if b == 0x55:
                print(" push rbp", end="")
            elif b == 0xc3:
                print(" ret", end="")
            elif b == 0xcc:
                print(" int3", end="")
            print()
    else:
        print(f"  No prologue found in 0x2000 range above call")
        # Show raw bytes around the call
        s = max(0, call_off - 32)
        e = min(len(text), call_off + 10)
        for k in range(s, e):
            marker = " <-- CALL" if k == call_off else ""
            print(f"    {TEXT_VADDR+k:#010x}: {text[k]:02x}{marker}")
