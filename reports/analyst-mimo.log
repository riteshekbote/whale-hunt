PARSER_END   = 0xc0d5eb6

# Dump all call sites from .text using objdump
result = subprocess.run(
    ['objdump', '-d', '-j', '.text', '--start-address=0x8000000', '--stop-address=0x10000000', BIN],
    capture_output=True, text=True, timeout=180
)
lines = result.stdout.split('\n')

# Collect all symbols (functions) - look for lines that are just "addr <sym>:" 
# For stripped binary these won't exist, so we also track function boundaries via call targets
# Actually for stripped, objdump won't give us function symbols.
# Instead: find all CALL instructions that land in [PARSER_START, PARSER_END]
callers = []
for i, line in enumerate(lines):
    # Match call instructions with absolute addresses (GNU objdump format: e8 <hex>)
    parts = line.split()
    if not parts:
        continue
    # Look for 'call' mnemonic
    for j, p in enumerate(parts):
        if p.lower() in ('call', 'callq') and j+1 < len(parts):
            addr_str = parts[0].rstrip(':')
            try:
                call_addr = int(addr_str, 16)
            except:
                continue
            # Next token should be the target
            target_str = parts[j+1].rstrip(',')
            try:
                if target_str.startswith('0x'):
                    target = int(target_str, 16)
                elif target_str.startswith('*%'):
                    # Indirect call - skip
                    continue
                else:
                    target = int(target_str, 16)
                if PARSER_START <= target <= PARSER_END:
                    callers.append((call_addr, target))
            except:
                continue

print(f'Found {len(callers)} direct call sites into response parser range')
for addr, target in callers:
    print(f'  caller={addr:#010x} -> parser={target:#010x}')
