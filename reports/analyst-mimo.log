import struct

BIN = "/tmp/opencode/whale_binary/extracted/opt/naver/whale/whale"

# .text section boundaries
TEXT_VADDR = 0x30df000
TEXT_FOFF  = 0x30de000
TEXT_SIZE  = 0x0fa8dce8
TEXT_END_VADDR = TEXT_VADDR + TEXT_SIZE  # ~0x12b6cc88

PARSER_START = 0xc0d5c91
PARSER_END   = 0xc0d5eb6

with open(BIN, 'rb') as f:
    f.seek(TEXT_FOFF)
    text = f.read(TEXT_SIZE)

def decode_instruction(data, offset):
    """Minimal x86-64 instruction length decoder for flow analysis"""
    if offset >= len(data):
        return 0, None
    b = data[offset]
    
    # REX prefix
    rex = 0
    if 0x40 <= b <= 0x4f:
        rex = b
        offset += 1
        if offset >= len(data):
            return 0, None
        b = data[offset]
    
    # CALL rel32 (E8 cd)
    if b == 0xe8:
        if offset + 4 < len(data):
            rel = struct.unpack_from('<i', data, offset+1)[0]
            vaddr = TEXT_VADDR + offset
            target = vaddr + 5 + rel
            return 5, ('call', vaddr, target)
    
    # CALL reg (FF /2)
    if b == 0xff:
        if offset + 1 < len(data):
            modrm = data[offset+1]
            reg = (modrm >> 3) & 7
            if reg == 2:  # CALL r/m
                return 2, ('call_reg', TEXT_VADDR + offset, None)
    
    # RET (C3)
    if b == 0xc3:
        return 1, ('ret', TEXT_VADDR + offset, None)
    
    # JMP rel32 (E9 cd)
    if b == 0xe9:
        if offset + 4 < len(data):
            rel = struct.unpack_from('<i', data, offset+1)[0]
            vaddr = TEXT_VADDR + offset
            target = vaddr + 5 + rel
            return 5, ('jmp', vaddr, target)
    
    # Conditional jumps (0x7x short, 0x0F 0x8x near)
    if 0x70 <= b <= 0x7f:
        return 2, ('jcc', TEXT_VADDR + offset, None)
    if b == 0x0f and offset + 1 < len(data) and 0x80 <= data[offset+1] <= 0x8f:
        return 6, ('jcc', TEXT_VADDR + offset, None)
    
    # PUSH/POP single-byte
    if b in (0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5a,0x5b,0x5c,0x5d,0x5e,0x5f):
        return 1, ('push_pop', TEXT_VADDR + offset, None)
    
    # MOV r,r / various common instructions - just return estimated length
    # For accurate analysis, we'd need a full decoder, but for finding CALLs
    # we mainly need: identify function prologues and CALL targets
    
    # Heuristic: if we can't decode, return 1 byte
    return 1, None

# Scan through text looking for CALL instructions that target our parser range
# Strategy: find all E8 bytes, decode the rel32, check if target is in range
# Then verify by checking if the instruction before is a plausible function boundary
callers = []
i = 0
while i < len(text) - 5:
    # Look for E8 (CALL rel32)
    if text[i] == 0xe8:
        rel = struct.unpack_from('<i', text, i+1)[0]
        vaddr = TEXT_VADDR + i
        target = vaddr + 5 + rel
        
        if PARSER_START <= target <= PARSER_END:
            # Check plausibility: is there a plausible function boundary before?
            # Look backwards for: RET (c3), UD2 (0f 0b), INT3 (cc), or start of another call sequence
            prev_is_boundary = False
            for j in range(1, min(20, i+1)):
                pb = text[i-j]
                if pb == 0xc3 or pb == 0xcc or pb == 0x0b:  # RET, INT3, or part of UD2
                    prev_is_boundary = True
                    break
                # Function prologue: push rbp (55) + mov rbp,rsp (48 89 e5)
                if pb == 0x55 and i-j-1 >= 0 and text[i-j-1] == 0x48 and text[i-j] == 0x89:
                    prev_is_boundary = True
                    break
                if pb == 0x55 and i-j >= 0:
                    prev_is_boundary = True
                    break
            
            # Also check if next instruction looks valid
            next_off = i + 5
            if next_off < len(text):
                nb = text[next_off]
                # Next should be a plausible x86 instruction start (not random data)
                # Common: 48 89 xx (mov), 89 xx (mov), 84 xx (test), 31 xx (xor), etc.
                if nb in (0x48, 0x89, 0x84, 0x31, 0x33, 0x85, 0x48, 0x8b, 0xc3, 0xcc):
                    prev_is_boundary = True
            
            if prev_is_boundary:
                callers.append((vaddr, target, i))
    i += 1

print(f'Found {len(callers)} plausible CALL sites into response parser')
for addr, target, off in callers:
    # Disassemble context
    start = max(0, off-16)
    end = min(len(text), off+20)
    ctx = ' '.join(f'{text[j]:02x}' for j in range(start, end))
    print(f'  caller={addr:#010x} -> parser={target:#010x}')
    print(f'    context: ...{ctx}...')
