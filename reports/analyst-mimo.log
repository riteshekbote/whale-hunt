import struct

target = 0xc0d5c10
with open('whale', 'rb') as f:
    data = f.read()

# Search for 32-bit references (for LEA RIP-relative)
target_low = target & 0xFFFFFFFF
found = []
for i in range(len(data) - 7):
    # Look for RIP-relative LEA (48 8d xx xx xx xx xx or 4c 8d xx xx xx xx xx)
    if data[i] in [0x48, 0x4c] and data[i+1] == 0x8d:
        modrm = data[i+2]
        if (modrm & 0xc7) == 0x05:  # RIP-relative
            disp = struct.unpack_from('<i', data, i+3)[0]
            instr_end = i + 7
            ref_addr = (instr_end + disp) & 0xFFFFFFFF
            if ref_addr == target_low:
                found.append(i)
                if len(found) >= 10:
                    break

print(f'Found {len(found)} RIP-relative references to 0x{target:x}:')
for f_addr in found:
    # Show context
    start = max(0, f_addr - 10)
    end = min(len(data), f_addr + 10)
    context = data[start:end]
    print(f'  LEA at 0x{f_addr:x}')
    print(f'  Context: {context.hex()}')
