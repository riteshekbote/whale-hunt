import struct

# Find all callers of response parser at 0xc0d5c10
target = 0xc0d5c10
with open('whale', 'rb') as f:
    data = f.read()

# Search for direct E8 call instructions
callers = []
for i in range(len(data) - 5):
    if data[i] == 0xE8:
        rel = struct.unpack_from('<i', data, i+1)[0]
        caller = i + 5
        if caller + rel == target:
            callers.append(i)
            if len(callers) >= 10:
                break

print(f'Found {len(callers)} callers of 0x{target:x}:')
for c in callers:
    print(f'  0x{c:x}')

# Also search for indirect calls via function pointer tables
# Check if 0xc0d5c10 appears in .rodata or .data sections
target_bytes = struct.pack('<Q', target)
positions = []
for i in range(0, len(data) - 8, 8):
    if data[i:i+8] == target_bytes:
        positions.append(i)

print(f'\\nFound {len(positions)} function pointer references:')
for p in positions[:10]:
    print(f'  0x{p:x}')
