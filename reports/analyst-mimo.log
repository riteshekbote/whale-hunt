            elif data[i+1:i+5] == b'\x48\x83\xec':
                candidates.append(('ret_then_sub_rsp', i+1))
    
    # Show the candidates closest to the parser
    for pattern, addr in candidates[-10:]:
        print(f'{pattern} at 0x{addr:x} (delta from parser: {parser_addr - addr})')
