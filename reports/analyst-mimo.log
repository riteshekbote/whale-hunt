import struct
target = 0x205fd1c  # string address
binary_path = '/tmp/opencode/whale_binary/extracted/opt/naver/whale/whale'
with open(binary_path, 'rb') as f:
    # Search for LEA r64, [rip+disp32] instructions that reference the string
    # LEA format: 48 8d xx xx xx xx xx (with mod=00 reg=r64 r/m=101)
    for offset in range(0xc000000, 0xc500000, 1):  # search in whale code section
        f.seek(offset)
        data = f.read(7)
        if data[:3] == b'\\x48\\x8d' and (data[3] & 0xc7) == 0x05:  # LEA r64, [rip+disp32]
            disp = struct.unpack('<i', data[3:7])[0] & 0xffffffff
            if disp >= 0x80000000:
                disp -= 0x100000000
            ref_addr = offset + 7 + disp
            if abs(ref_addr - target) < 0x10:
                print(f'  LEA at 0x{offset:08x} references 0x{ref_addr:08x} (target: 0x{target:08x})')
" 2>&1 | head -10
